{
  "namespace": "chest",

  "oc_spike_grid@chest.small_chest_grid": {
    "size": [ 162, 36 ],
    "grid_dimensions": [ 9, 2 ]
  },

  "oc_spike_button_slot@common.container_item": {
    "size": [ 44, 18 ]
  },

  "oc_spike_button_frame": {
    "type": "panel",
    "size": [ 48, 22 ],
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "controls": [
      { "bg@common.cell_image_panel": { "size": [ 48, 22 ] } },
      {
        "slot@chest.oc_spike_button_slot": {
          "collection_name": "container_items",
          "collection_index": 26,
          "offset": [ 2, 2 ]
        }
      },
      {
        "label": {
          "type": "label",
          "layer": 3,
          "size": [ 48, 9 ],
          "anchor_from": "bottom_middle",
          "anchor_to": "bottom_middle",
          "offset": [ 0, -2 ],
          "text": "Codex",
          "color": [ 1.0, 0.85, 0.3 ],
          "font_size": "small",
          "text_alignment": "center",
          "shadow": true
        }
      }
    ]
  },

  "oc_spike_panel_top_half": {
    "type": "panel",
    "size": [ "100%", "50%" ],
    "offset": [ 0, 12 ],
    "anchor_to": "top_left",
    "anchor_from": "top_left",
    "controls": [
      { "chest_label@chest.chest_label": {} },
      { "small_chest_grid@chest.oc_spike_grid": { "offset": [ 7, 9 ] } },
      {
        "oc_spike_button@chest.oc_spike_button_frame": {
          "anchor_from": "top_left",
          "anchor_to": "top_left",
          "offset": [ 185, 9 ]
        }
      }
    ]
  },

  "oc_spike_root_panel@common.root_panel": {
    "size": [ 240, 166 ],
    "layer": 1,
    "controls": [
      { "common_panel@common.common_panel": { "size": [ 240, 166 ] } },
      {
        "chest_panel": {
          "type": "panel",
          "layer": 5,
          "controls": [
            { "small_chest_panel_top_half@chest.oc_spike_panel_top_half": {} },
            { "inventory_panel_bottom_half_with_label@common.inventory_panel_bottom_half_with_label": {} },
            { "hotbar_grid@common.hotbar_grid_template": {} },
            { "inventory_take_progress_icon_button@common.inventory_take_progress_icon_button": {} },
            { "flying_item_renderer@common.flying_item_renderer": { "layer": 15 } }
          ]
        }
      },
      { "inventory_selected_icon_button@common.inventory_selected_icon_button": {} },
      { "gamepad_cursor@common.gamepad_cursor_button": {} }
    ]
  },

  "oc_spike_panel": {
    "type": "panel",
    "controls": [
      { "container_gamepad_helpers@common.container_gamepad_helpers": {} },
      { "selected_item_details_factory@common.selected_item_details_factory": {} },
      { "item_lock_notification_factory@common.item_lock_notification_factory": {} },
      { "root_panel@chest.oc_spike_root_panel": {} }
    ]
  },

  "small_chest_screen": {
    "modifications": [
      {
        "array_name": "variables",
        "operation": "insert_front",
        "value": [
          {
            "requires": "($container_title = 'oc_spike')",
            "$screen_content": "chest.oc_spike_panel"
          }
        ]
      }
    ]
  }
}
